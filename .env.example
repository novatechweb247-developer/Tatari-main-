# Tatari Furniture Environment Variables

# Cloudinary Media Storage (Permanent image and video storage)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Secret URL Admin Access (Long unguessable path, e.g. /portal-tatari-vault-7k9w2x4m8q)
# Leave empty to use default secure path: /portal-tatari-vault-7k9w2x4m8q
ADMIN_SECRET_PATH=/portal-tatari-vault-7k9w2x4m8q

# Optional Session Encryption Key for admin tokens
ADMIN_SESSION_SECRET=
